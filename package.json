{
  "name": "offisims",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tools:dev": "yarn workspace @offisims/tools dev",
    "tools:build": "yarn workspace @offisims/tools build",
    "server:dev": "yarn workspace @offisims/server dev",
    "server:build": "yarn workspace @offisims/server build",
    "client:dev": "yarn workspace @offisims/client dev",
    "client:build": "yarn workspace @offisims/client build",
    "shared:build": "yarn workspace @offisims/shared build",
    "build": "yarn shared:build && yarn tools:build && yarn server:build && yarn client:build",
    "dev": "echo 'Use tools:dev, server:dev, or client:dev'"
  },
  "dependencies": {
    "openai": "^6.27.0"
  }
}
